5=(SOLICITE AO USUARIO UM NUMERO INTEIRO E DETERMINE QUANTOS DIGITOS ESSE NUMERO POSSUI )
#include <stdio.h>

int main() {
    int numero, contador = 0;
    
    printf("Digite un numero inteiro: ");
    scanf("%d", &numero);
    
    // Tratamento para números negativos (o sinal não conta como dígito)
    if (numero < 0) {
        numero = -numero;
    }
    
    // O 'do-while' garante que o número 0 seja contado como 1 dígito
    do {
        contador++;
        numero = numero / 10;
    } while (numero > 0);
    
    printf("O numero possui %d digitos.\n", contador);
    
    return 0;
}
