1=(imprimir os numeros de 1 a 10)
#include <stdio.h>

int main() {
    int i;
    
    for (i = 1; i <= 10; i++) {
        printf("%d\n", i);
    }
    
    return 0;
}
------------------------------------------------
2=(números de 10 a 1, em ordem decrescente)
#include <stdio.h>

int main() {
    int i;
    
    for (i = 10; i >= 1; i--) {
        printf("%d\n", i);
    }
    
    return 0;
}
-----------------------------------------------
3=( calcule e imprima numeros de 1 a 100)
#include <stdio.h>

int main() {
    int i;
    int soma = 0; // Importante inicializar com 0
    
    for (i = 1; i <= 100; i++) {
        soma = soma + i; // Ou: soma += i;
    }
    
    printf("A soma de 1 a 100 eh: %d\n", soma);
    
    return 0;
}
