4=( numero inteiro de N e imprima todos os numeros de 1 ate N)
#include <stdio.h>

int main() {
    int N, i;
    
    printf("Digite um numero inteiro: ");
    scanf("%d", &N);
    
    for (i = 1; i <= N; i++) {
        printf("%d\n", i);
    }
    
    return 0;
}
